# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the web app)
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (Nginx = 1). Needed for correct client IPs in rate limiting.
TRUST_PROXY=0
LOG_LEVEL=info

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/system-design-academy

# --- Auth (use long random values: `openssl rand -base64 48`) ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Seed admin user (created by `npm run seed` if it doesn't exist) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-123
ADMIN_NAME=Site Admin

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_15_MIN=10
